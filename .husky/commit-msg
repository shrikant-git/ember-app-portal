#!/usr/bin/env sh
message=$(head -n 1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([[:alnum:]./_-]+\))?!?: .+'
if ! printf '%s\n' "$message" | grep -Eq "$pattern"; then
  echo "Invalid commit message: $message"
  echo "Use Conventional Commits, e.g. feat(appointments): add status filter"
  exit 1
fi
